{
    "name": "infrangible/m2-catalog-product-option-badge",
    "description": "Shows a badge image on top of the product gallery as soon as a shopper selects a custom option value, so the choice becomes visible on the product picture.",
    "type": "magento2-module",
    "version": "1.5.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Catalog",
        "badge image for custom option values",
        "option image on the product gallery",
        "visual custom options"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-option-badge",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionBadge\\": "src"
        }
    }
}
